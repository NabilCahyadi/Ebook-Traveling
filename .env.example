# ================================================
# APPLICATION SETTINGS
# ================================================
APP_NAME="MeatMap"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://yourdomain.com

# Locale Settings
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Maintenance Mode
APP_MAINTENANCE_DRIVER=file

# ================================================
# SECURITY SETTINGS
# ================================================
BCRYPT_ROUNDS=12

# ================================================
# LOGGING
# ================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ================================================
# DATABASE CONFIGURATION
# ================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# SSL untuk database (opsional, untuk cloud database)
# MYSQL_ATTR_SSL_CA=/path/to/ca-certificate.crt

# ================================================
# SESSION & CACHE
# ================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
# Jika menggunakan Redis:
# CACHE_STORE=redis

# ================================================
# QUEUE CONFIGURATION
# ================================================
QUEUE_CONNECTION=database
# Jika menggunakan Redis:
# QUEUE_CONNECTION=redis

# ================================================
# FILESYSTEM
# ================================================
FILESYSTEM_DISK=public

# ================================================
# REDIS (Opsional - untuk cache/queue/session yang lebih cepat)
# ================================================
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ================================================
# MAIL CONFIGURATION
# ================================================
# Gunakan SMTP untuk production (contoh: Mailtrap, Mailgun, SendGrid, dll)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ================================================
# GOOGLE OAUTH CONFIGURATION
# ================================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI="${APP_URL}/login/google/callback"
GOOGLE_REDIRECT_URI_REGISTER="${APP_URL}/register/google/callback"

# ================================================
# MAYAR.ID PAYMENT GATEWAY
# ================================================
# PENTING: Ganti ke 'production' dan gunakan API key production!
MAYAR_API_KEY=your_mayar_production_api_key
MAYAR_ENVIRONMENT=production
MAYAR_WEBHOOK_TOKEN=your_mayar_webhook_token
MAYAR_CALLBACK_URL="${APP_URL}/api/mayar/callback"
MAYAR_RETURN_URL="${APP_URL}/payment/success"

# ================================================
# AWS S3 (Opsional - untuk penyimpanan file di cloud)
# ================================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ================================================
# VITE
# ================================================
VITE_APP_NAME="${APP_NAME}"
